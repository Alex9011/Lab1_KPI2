        UUID author_id PK
        string full_name
    }
    Copy {
        UUID copy_id PK
        string inventory_number UK "унікальний у бібліотеці"
        UUID book_id FK
    }
    Member {
        UUID member_id PK
        string full_name
        string email
    }
    Loan {
        UUID loan_id PK
        UUID member_id FK
